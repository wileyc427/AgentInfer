<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!--
      Off, against the repo-wide default. A test assembly is never consumed from
      a package, so the .xml it would produce is written and read by nobody.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Test source is not consumer code; the AOT analyzers add noise here. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!--
      A normal reference, NOT OutputItemType="Analyzer". These tests drive the
      generator directly through CSharpGeneratorDriver, so they need the type,
      not the compiler plugin. Loading it as an analyzer here would run it over
      the test project's own source, which is not what is being tested.
    -->
    <ProjectReference Include="../../src/Agentry.Generator/Agentry.Generator.csproj" />
    <ProjectReference Include="../../src/Agentry.Abstractions/Agentry.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
