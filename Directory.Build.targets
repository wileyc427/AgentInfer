<Project>

  <!--
    The trim and AOT analyzers, on for everything that ships.

    Here rather than in Directory.Build.props because props is imported before
    the project body, where $(TargetFramework) is still empty and
    IsTargetFrameworkCompatible('', 'net8.0') is false. The condition would
    never match and nothing would say so.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))
                            AND '$(IsPackable)' != 'false'">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!--
    Scoped to what ships. A library makes a promise to code it will never see,
    so the promise has to be checked; an application decides for itself at
    publish time and a test assembly is never published. A sample that wants the
    check sets the three properties itself.
  -->

  <!--
    The README, inside every package that ships. Without PackageReadmeFile the
    nuget.org listing is blank.

    Here rather than in props for the same reason as the analyzers: IsPackable
    is set in the project body, so a condition on it in props reads as empty and
    the item lands on the samples and test projects too.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <!--
      Absolute, off this file. The default None glob is project-relative and
      never sees a file at the repository root, so a relative Include would
      match nothing.
    -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
