<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ledger</RootNamespace>

    <!--
      Writes what the generator produced to obj/generated/ so it can be read,
      diffed and reviewed. On for the sample on purpose: "you can just open the
      generated file" is a claim this design makes, and it should be true here.
    -->
    <!-- A sample is something to read and run, not something to ship. -->
    <IsPackable>false</IsPackable>

    <!--
      Off, against the repo-wide default. Nothing here is consumed from a
      package, so there is no IntelliSense to serve — the only effect would be
      turning the XML-comment warnings into build errors on a `///` above a
      local function in top-level statements, which is a comment C# will not
      attach to anything.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Beside the binary, because ConfigurationBuilder reads from BaseDirectory. -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />

    <!--
      The same transitivity gap as the analyzer below, for the same reason: the
      buildTransitive targets that ship in the AgentInfer package do this
      automatically, and none of a package's MSBuild files flow through a
      ProjectReference. So the two lines the package would have added are here
      by hand, and only projects inside this repo need them.
    -->
    <AdditionalFiles Include="Prompts/**/*.md" />
    <CompilerVisibleProperty Include="ProjectDir" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AgentInfer/AgentInfer.csproj" />
    <ProjectReference Include="../../src/AgentInfer.DependencyInjection/AgentInfer.DependencyInjection.csproj" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />

    <!--
      The generator has to be referenced AGAIN, here, and this is the gotcha
      worth knowing: analyzers do not flow transitively through
      ProjectReference. AgentInfer references the generator as an Analyzer, but a
      project referencing AgentInfer gets the runtime and no generator — the build
      succeeds for the library and then every consumer sees "type not found".

      It works transitively through a NuGet package (analyzers/dotnet/cs in the
      nupkg), so this line is only needed for projects inside this repo. There
      is a repo-local .props that could hide it; left explicit because the
      failure it prevents is confusing enough to be worth seeing.
    -->
    <ProjectReference Include="../../src/AgentInfer.Generator/AgentInfer.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
