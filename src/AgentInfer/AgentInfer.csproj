<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0 as well as net10.0, because net8.0 is the LTS most consumers are on.

      The reply binder needs RespectNullableAnnotations and
      RespectRequiredConstructorParameters, which are System.Text.Json 9+ APIs.
      net8.0 gets them because Microsoft.Extensions.AI brings System.Text.Json
      in as a package there rather than using the in-box one, so both targets
      bind identically. Dropping that dependency would weaken binding on net8.0
      only, and nothing would fail loudly to say so.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Runtime for AgentInfer. Generated agents call into this.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The generator travels with the runtime package, so referencing AgentInfer is
      all a consumer needs. That claim is not free: OutputItemType="Analyzer"
      loads the generator into THIS project's compilation and nothing more, and
      ReferenceOutputAssembly="false" keeps it out of the dependency list, so
      without the target below the package ships a runtime with no generator and
      every consumer sees "type not found". Verified by opening the nupkg, which
      is the only way to catch it.
    -->
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);PackGenerator
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--
    The analyzer goes to analyzers/dotnet/cs, which is one folder for the whole
    package rather than one per target framework — but this target is a
    TargetsForTfmSpecificContentInPackage hook, so it runs once per TFM. Adding
    it every time is NU5118 ("the package already contains this file"), which is
    a pack-time error that only appears once a second TFM exists.

    So it contributes on the first target framework only. Computed rather than
    written out, because a hardcoded name silently stops matching the day
    somebody reorders TargetFrameworks, and the Error below would stop guarding
    anything.
  -->
  <PropertyGroup>
    <_PackGeneratorTfm>$(TargetFrameworks.Split(';')[0])</_PackGeneratorTfm>
  </PropertyGroup>

  <Target Name="PackGenerator" DependsOnTargets="ResolveReferences"
          Condition="'$(TargetFramework)' == '$(_PackGeneratorTfm)'">
    <ItemGroup>
      <!--
        Taken from @(Analyzer) rather than from a hardcoded bin path, so it
        cannot drift from the configuration and target framework actually built.
        The filter matters: @(Analyzer) also holds the analyzers that arrive
        with Roslyn's own packages, and packing those would ship somebody else's
        assemblies inside this one.
      -->
      <_AgentInferGenerator Include="@(Analyzer)" Condition="'%(Filename)' == 'AgentInfer.Generator'" />
      <TfmSpecificPackageFile Include="@(_AgentInferGenerator)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>

    <!--
      The failure this replaces is a package that restores, builds, and produces
      "type or namespace AdvisorAgent could not be found" in somebody else's
      project. Breaking the pack is the cheapest place to find out.
    -->
    <Error Condition="'@(_AgentInferGenerator)' == ''"
           Text="AgentInfer.Generator.dll is not in @(Analyzer), so this package would ship a runtime with no generator." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="../AgentInfer.Abstractions/AgentInfer.Abstractions.csproj" />
    <ProjectReference Include="../AgentInfer.Generator/AgentInfer.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ToolCallLog.Record stays internal: consumers read the log, they never
      write it. Widening the API so a test can reach it would be letting the
      test shape the surface.
    -->
    <InternalsVisibleTo Include="AgentInfer.Tests" />
  </ItemGroup>

  <!--
    Include, and only in the outer build. A multi-targeted pack collects files
    that are not framework-specific from the outer evaluation, where
    TargetFramework is empty and the SDK's default None glob is switched off —
    so an Update there matches nothing and the file leaves the package without
    a word. Inside an inner build the glob does have it, which is why this
    needs no Update to go with it.

    The consequence of getting it wrong is quiet: the package restores, builds,
    and ignores [Agent(PromptFile = "...")] in somebody else's project. The
    check below is what turns that into a pack failure here.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == ''">
    <None Include="build/AgentInfer.targets" Pack="true" PackagePath="buildTransitive/AgentInfer.targets" />
  </ItemGroup>

  <Target Name="VerifyBuildTransitiveIsPacked" BeforeTargets="GenerateNuspec" Condition="'$(TargetFramework)' == ''">
    <Error Condition="'@(None->WithMetadataValue('PackagePath','buildTransitive/AgentInfer.targets'))' == ''"
           Text="build/AgentInfer.targets is not in the package, so [Agent(PromptFile)] would silently do nothing for consumers." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
