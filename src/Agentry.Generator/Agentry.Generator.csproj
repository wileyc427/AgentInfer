<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0 is not a preference. A generator is a plugin loaded INTO
      the compiler, and the compiler runs on netstandard2.0 — targeting anything
      else produces an analyzer the SDK silently declines to load, which
      presents as "my generator produced nothing" with no error anywhere.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <Description>Roslyn source generator for Agentry.</Description>

    <!--
      Off, against the repo-wide default in Directory.Build.props. This assembly
      reaches nobody as a package — it ships inside Agentry under
      analyzers/dotnet/cs — so there is no IntelliSense to serve, and the only
      effect of generating docs here is that the XML-comment warnings become
      build errors on comments attached to internal model records. Which they
      are: fifteen of them, all CS1587 and CS1573, none about a public surface.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets=all: Roslyn is supplied by the host compiler, never shipped. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The release-tracking analyzer reads these. Required by
      EnforceExtendedAnalyzerRules, and worth keeping: a diagnostic id that
      changes meaning between versions silently reclassifies somebody's build.
    -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Not packed on its own. analyzers/dotnet/cs is how NuGet knows to load a
      dll into the compiler, and this generator reaches consumers through that
      folder in the Agentry package — see PackGenerator there. Publishing a
      second package carrying the same generator would let a project reference
      both, load it twice, and get CS0101 on every generated type.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
