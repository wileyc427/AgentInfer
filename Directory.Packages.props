<Project>

  <!--
    Central package management: versions live here, never in a csproj. The
    generator and its tests must agree on the Roslyn version exactly, and two
    project files drifting apart produces errors that look like generator bugs.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Runtime">
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <!--
      One provider package covers OpenAI, Ollama, vLLM and anything else
      speaking the OpenAI wire format, since all of them differ only by
      endpoint. A package per provider would be a maintenance bill for nothing.
    -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Generator">
    <!--
      The oldest supported compiler, not the newest: a generator runs inside
      whatever Roslyn the consumer's SDK ships. Raising this raises the minimum
      SDK for everyone using the library.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <!--
      xunit.v3 4.x runs on Microsoft.Testing.Platform and no longer supports
      VSTest on the .NET 10 SDK. The runner is selected in global.json, and
      xunit.runner.visualstudio — the VSTest adapter — is gone; reintroducing it
      does nothing except restore a package.

      Anything in this group is invisible to version-guard.sh, which is the
      point: a test-tooling bump ships nothing. A PackageVersion that does ship
      must not be filed here.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- The trx report is an MTP extension, not part of the platform itself. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
  </ItemGroup>

</Project>
