<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      The trim and AOT analyzers are in Directory.Build.targets. This file is
      imported before the project sets TargetFramework, so a condition on it
      here evaluates to false without saying so.
    -->
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <!--
      Below 1.0 deliberately, and explicit: without it every package is 1.0.0,
      a promise this library has not made.

      Raise it in the same commit as the change it describes. The publish job
      skips duplicates, so shipping a change without moving this publishes
      nothing and still reports success. .github/version-guard.sh enforces it on
      pull requests. The guard does not watch this file, so a package property
      edited here is on you.
    -->
    <Version>0.3.0</Version>
    <Authors>wileyc427</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wileyc427/AgentInfer</RepositoryUrl>
    <PackageProjectUrl>https://github.com/wileyc427/AgentInfer</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>agents;llm;ai;source-generator;roslyn;openai;ollama;microsoft-extensions-ai</PackageTags>

    <!--
      Ships the XML documentation, which is this library's API reference.

      It belongs here rather than in Directory.Build.targets, which is the
      opposite of the analyzers above. The SDK derives the compiler's
      DocumentationFile during props evaluation; the switch making XML-comment
      warnings fatal is read later. Set it in targets and the build enforces
      those warnings while shipping no .xml at all.

      Being early means it cannot be scoped by IsPackable, which the project
      body sets. Projects that ship nothing turn it off themselves.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      CS1591 (missing XML comment on a public member) is suppressed so that the
      documentation which exists can ship. Write the missing comments and delete
      this line.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Symbols, so stepping into this library lands on source rather than IL. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <!--
      Normalizes the paths in the PDB so Source Link resolves them against the
      repository rather than a runner directory. Local builds want the real
      absolute paths.
    -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
