<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      The trim and AOT analyzers live in Directory.Build.targets, not here. See
      the comment there: this file is imported before the project sets
      TargetFramework, so a condition on it silently evaluates to false.
    -->
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Authors>wileyc427</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wileyc427/OO-Agents-Dotnet</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>
